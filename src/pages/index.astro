---
import "../styles/global.css";
import site from "../data/site.json";

const { services, projects } = site;
const assetUrl = (path: string) => path.startsWith("http") ? path : `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const heroStyle = `background-image: url('${assetUrl(site.hero.image)}')`;
const whyStyle = `background-image: url('${assetUrl(site.why.image)}')`;
const contactStyle = `background-image: url('${assetUrl(site.contact.image)}')`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="WCCL Systems delivers integrated technology, infrastructure, controls, and lifecycle support." />
    <title>WCCL Systems | Integrated Solutions Built to Last</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">{site.announcement} <a href="#projects">See our work <span aria-hidden="true">→</span></a></div>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#top" aria-label="WCCL Systems home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span><strong>WCCL</strong><small>SYSTEMS</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><span class="sr-only">Open menu</span></button>
        <nav id="primary-nav" aria-label="Primary navigation">
          <a href="#about">Experience</a>
          <a href="#services">Services</a>
          <a href="#projects">Projects</a>
          <a href="#safety">Safety</a>
          <a href="#careers">Careers</a>
          <a href="#contact">Contact</a>
          <a class="phone-link" href={`tel:${site.phoneLink}`}>{site.phone}</a>
          <a class="button button-small" href="#contact">Get a Quote <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="top" class="hero" style={heroStyle}>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <p class="eyebrow light">{site.hero.eyebrow}</p>
          <h1>{site.hero.headline.split("\n").map((line) => <>{line}<br /></>)}</h1>
        </div>
        <a class="scroll-cue" href="#about" aria-label="Scroll to learn more">↓</a>
      </section>

      <section class="feature-strip">
        <div class="container feature-inner">
          <div class="feature-rule"></div>
          <h2>{site.feature.headline}</h2>
          <p>{site.feature.text}</p>
          <a class="text-link light" href="#projects">See our approach <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="about" class="intro section-pad">
        <div class="container narrow">
          <p class="eyebrow">{site.intro.eyebrow}</p>
          <h2>{site.intro.headline}</h2>
          <div class="intro-copy">
            {site.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="services" class="services container">
        <div class="services-grid">
          {services.map((service, index) => (
            <article class:list={["service-card", index === 4 && "wide-card"]}>
              <img src={assetUrl(service.image)} alt="" loading="lazy" />
              <div class="service-card-body">
                <span class="card-number">0{index + 1}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href="#contact" aria-label={`Learn more about ${service.title}`}>Explore <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="safety" class="why-section section-pad">
        <div class="container why-grid">
          <div class="why-media" style={whyStyle} role="img" aria-label="Specialist working with technology systems"></div>
          <div class="why-copy">
            <p class="eyebrow">{site.why.eyebrow}</p>
            <h2>{site.why.headline}</h2>
            <p>{site.why.text}</p>
            <ul>
              {site.why.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="button" href="#contact">Learn More <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section id="projects" class="projects section-pad">
        <div class="container">
          <div class="section-heading-row">
            <div><p class="eyebrow">Proven in the field</p><h2>Featured Projects</h2></div>
            <a class="text-link" href="#contact">View all projects <span aria-hidden="true">→</span></a>
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <div class="project-image"><img src={assetUrl(project.image)} alt="" loading="lazy" /></div>
                <p>{project.type}</p>
                <h3>{project.title}</h3>
                <a href="#contact" aria-label={`View ${project.title}`}>View project <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="contact section-pad" style={contactStyle}>
        <div class="contact-overlay"></div>
        <div class="container contact-grid">
          <div class="contact-intro">
            <p class="eyebrow light">{site.contact.eyebrow}</p>
            <h2>{site.contact.headline}</h2>
            <p>{site.contact.text}</p>
            <p class="contact-phone">Call us<br /><a href={`tel:${site.phoneLink}`}>{site.phone}</a></p>
          </div>
          <form class="quote-form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
            <div class="field"><label for="project">Project Name</label><input id="project" name="project" required placeholder="Project Name" /></div>
            <div class="field"><label for="location">Project Location</label><input id="location" name="location" required placeholder="City, State, ZIP" /></div>
            <div class="field"><label for="company">Company Name</label><input id="company" name="company" placeholder="Company Name" /></div>
            <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" placeholder="Phone" /></div>
            <div class="field full"><label for="email">Email</label><input id="email" name="email" type="email" required placeholder="Email Address" /></div>
            <div class="field full"><label for="scope">Brief Scope of Project</label><textarea id="scope" name="scope" required rows="4" placeholder="How can we help?"></textarea></div>
            <button class="button button-white" type="submit">Send Inquiry <span aria-hidden="true">→</span></button>
          </form>
        </div>
      </section>

      <section class="partner-band"><div class="container"><p>Your Partner in Safety, Quality, and Service</p><span>WCCL SYSTEMS</span></div></section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span><strong>WCCL</strong><small>SYSTEMS</small></span></a>
          <p>Integrated systems. Practical solutions. Lasting performance.</p>
          <div class="socials"><a href="#" aria-label="LinkedIn">in</a><a href="#" aria-label="Facebook">f</a><a href="#" aria-label="Instagram">ig</a></div>
        </div>
        <div><h3>Headquarters</h3><p>WCCL Systems<br />{site.address.line1}<br />{site.address.line2}</p><p><a href={`tel:${site.phoneLink}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
        <div><h3>Services</h3><ul><li><a href="#services">Systems Integration</a></li><li><a href="#services">Infrastructure</a></li><li><a href="#services">Automation & Controls</a></li><li><a href="#services">Field Services</a></li><li><a href="#services">Lifecycle Support</a></li></ul></div>
        <div id="careers"><h3>Company</h3><ul><li><a href="#about">Experience</a></li><li><a href="#projects">Projects</a></li><li><a href="#safety">Safety</a></li><li><a href="#careers">Careers</a></li><li><a href="#contact">Contact</a></li></ul></div>
      </div>
      <div class="container copyright"><p>© {new Date().getFullYear()} WCCL Systems. All rights reserved.</p><p>Built for performance.</p></div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#primary-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }));
    </script>
  </body>
</html>

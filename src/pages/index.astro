---
import "../styles/global.css";
import site from "../data/site.json";

const { services, gallery } = site;
const assetUrl = (path: string) => path.startsWith("http") ? path : `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const heroStyle = `background-image: url('${assetUrl(site.hero.image)}')`;
const whyStyle = `background-image: url('${assetUrl(site.why.image)}')`;
const contactStyle = `background-image: url('${assetUrl(site.contact.image)}')`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="WCCL Systems delivers integrated technology, infrastructure, controls, and lifecycle support." />
    <title>WCCL Systems | Integrated Solutions Built to Last</title>
    <script is:inline>
      // Netlify Identity sends recovery, confirmation, and invitation links to
      // the site's root. The Identity widget lives at /admin/, so preserve the
      // token while routing those callbacks to the CMS login page.
      if (location.hash && /(?:recovery|invite|confirmation|email_change)_token=/.test(location.hash)) {
        location.replace(`/admin/${location.hash}`);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">{site.announcement} <a href="#services">Explore our services <span aria-hidden="true">→</span></a></div>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#top" aria-label="WCCL Systems home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span><strong>WCCL</strong><small>SYSTEMS</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><span class="sr-only">Open menu</span></button>
        <nav id="primary-nav" aria-label="Primary navigation">
          <a href="#about">Experience</a>
          <a href="#services">Services</a>
          <a href="#safety">Safety</a>
          <a href="#contact">Contact</a>
          <a class="phone-link" href={`tel:${site.phoneLink}`}>{site.phone}</a>
          <a class="button button-small" href="#contact">Get a Quote <span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="top" class="hero" style={heroStyle}>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <p class="eyebrow light">{site.hero.eyebrow}</p>
          <h1>{site.hero.headline.split("\n").map((line) => <>{line}<br /></>)}</h1>
        </div>
        <a class="scroll-cue" href="#about" aria-label="Scroll to learn more">↓</a>
      </section>

      <section class="feature-strip">
        <div class="container feature-inner">
          <div class="feature-rule"></div>
          <h2>{site.feature.headline}</h2>
          <p>{site.feature.text}</p>
          <a class="text-link light" href="#contact">Discuss your project <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="about" class="intro section-pad">
        <div class="container narrow">
          <p class="eyebrow">{site.intro.eyebrow}</p>
          <h2>{site.intro.headline}</h2>
          <div class="intro-copy">
            {site.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="services" class="services container">
        <div class="services-grid">
          {services.map((service, index) => (
            <article class:list={["service-card", index === 4 && "wide-card"]}>
              <img src={assetUrl(service.image)} alt="" loading="lazy" />
              <div class="service-card-body">
                <span class="card-number">0{index + 1}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href="#contact" aria-label={`Learn more about ${service.title}`}>Explore <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="field-gallery section-pad">
        <div class="container">
          <div class="section-heading-row">
            <div><p class="eyebrow">In the field</p><h2>Work built to last.</h2></div>
            <p class="gallery-intro">A look at the concrete structures, tanks, shafts, and lined systems our crews work on every day.</p>
          </div>
          <div class="field-gallery-grid">
            {gallery.map((item) => <figure><img src={assetUrl(item.image)} alt={item.alt} loading="lazy" /></figure>)}
          </div>
        </div>
      </section>

      <section id="safety" class="why-section section-pad">
        <div class="container why-grid">
          <div class="why-media" style={whyStyle} role="img" aria-label="Specialist working with technology systems"></div>
          <div class="why-copy">
            <p class="eyebrow">{site.why.eyebrow}</p>
            <h2>{site.why.headline}</h2>
            <p>{site.why.text}</p>
            <ul>
              {site.why.points.map((point) => <li>{point}</li>)}
            </ul>
            <a class="button" href="#contact">Learn More <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section id="contact" class="contact section-pad" style={contactStyle}>
        <div class="contact-overlay"></div>
        <div class="container contact-grid">
          <div class="contact-intro">
            <p class="eyebrow light">{site.contact.eyebrow}</p>
            <h2>{site.contact.headline}</h2>
            <p>{site.contact.text}</p>
            <p class="contact-phone">Call us<br /><a href={`tel:${site.phoneLink}`}>{site.phone}</a></p>
          </div>
          <div class="contact-details">
            <p class="eyebrow light">Contact details</p>
            <p>WCCL Systems<br />{site.address.line1}<br />{site.address.line2}</p>
            <p><a href={`tel:${site.phoneLink}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <form class="quote-form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
            <div class="field"><label for="project">Project Name</label><input id="project" name="Project Name" required placeholder="Project Name" /></div>
            <div class="field"><label for="location">Project Location</label><input id="location" name="Project Location" required placeholder="City, State, ZIP" /></div>
            <div class="field"><label for="company">Company Name</label><input id="company" name="Company Name" placeholder="Company Name" /></div>
            <div class="field"><label for="phone">Phone</label><input id="phone" name="Phone" type="tel" placeholder="Phone" /></div>
            <div class="field full"><label for="sender-email">Email</label><input id="sender-email" name="Email" type="email" required placeholder="Email Address" /></div>
            <div class="field full"><label for="scope">Brief Scope of Project</label><textarea id="scope" name="Project Scope" required rows="4" placeholder="How can we help?"></textarea></div>
            <button class="button button-white" type="submit">Open Email <span aria-hidden="true">→</span></button>
          </form>
        </div>
      </section>

      <section class="partner-band"><div class="container"><p>Your Partner in Safety, Quality, and Service</p><span>WCCL SYSTEMS</span></div></section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span><strong>WCCL</strong><small>SYSTEMS</small></span></a>
          <p>Integrated systems. Practical solutions. Lasting performance.</p>
        </div>
        <div><h3>Headquarters</h3><p>WCCL Systems<br />{site.address.line1}<br />{site.address.line2}</p><p><a href={`tel:${site.phoneLink}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
        <div><h3>Services</h3><ul><li><a href="#services">Concrete Lining</a></li><li><a href="#services">Waterproofing</a></li><li><a href="#services">Structure Repair</a></li><li><a href="#services">Inspection Services</a></li><li><a href="#services">HDPE & PVC Welding</a></li></ul></div>
        <div><h3>Company</h3><ul><li><a href="#about">About WCCL Systems</a></li><li><a href="#safety">Safety & Quality</a></li><li><a href="#contact">Contact</a></li></ul></div>
      </div>
      <div class="container copyright"><p>© {new Date().getFullYear()} WCCL Systems. All rights reserved.</p><p>Built for performance.</p></div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#primary-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }));
    </script>
  </body>
</html>

---
import "../styles/global.css";
import site from "../data/site.json";
const asset = (path: string) => path.startsWith("http") ? path : `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const heroImage = "/images/wccl/img_9946.jpg";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Experience | WCCL Systems</title><style>.detail-hero{min-height:55vh;display:grid;align-items:end;padding:8rem 0 4rem;color:#fff;background:linear-gradient(90deg,rgba(12,45,47,.92),rgba(12,45,47,.42)),url('{asset(heroImage)}') center/cover}.detail-body{max-width:850px;padding:5rem 1.5rem 6rem}.detail-body p{font-size:1.2rem;line-height:1.75;color:#385355}.detail-body h2{font-size:2rem;color:#16494a}.detail-link{display:inline-block;margin-top:2rem;padding:.9rem 1.2rem;background:#16494a;color:#fff;text-decoration:none}</style></head><body><main><section class="detail-hero"><div class="container"><a class="text-link light" href="/">← Back to WCCL Systems</a><p class="eyebrow light">About WCCL Systems</p><h1>{site.intro.headline}</h1></div></section><section class="container detail-body"><p>{site.intro.paragraphs[0]}</p><p>{site.intro.paragraphs[1]}</p><h2>Built around long-term performance</h2><p>We bring practical field experience to lining, waterproofing, inspection, and concrete repair work for municipalities, utilities, industrial facilities, engineers, and contractors.</p><a class="detail-link" href="/#contact">Discuss your project →</a></section></main></body></html>
